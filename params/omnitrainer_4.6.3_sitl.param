# Omni Trainer SITL baseline for ArduPlane 4.6.3
#
# Flight-control values are derived from ONT_TA0801_SEPT2026_updated.param.
# Hardware-specific device IDs, board settings, calibrations and serial-bus
# assignments are intentionally excluded.  The sensor and servo overrides
# below adapt the real aircraft configuration to ArduPilot's JSBSim backend.

# Simulation backends
EFI_TYPE 9
RPM1_TYPE 3
RNGFND1_TYPE 10
RNGFND1_ORIENT 25
RNGFND1_MIN_CM 10
RNGFND1_MAX_CM 2400
RNGFND1_GNDCLEAR 19
RNGFND1_SCALING 1
RNGFND_LANDING 1
RNGFND_LND_ORNT 25
ARSPD_TYPE 100
ARSPD_USE 1
ARSPD_AUTOCAL 0
ARSPD_PRIMARY 0
SIM_TERRAIN 1
SIM_ADSB_COUNT -1
LOG_DISARMED 1
# JSBSim ground-contact jitter makes the simulated gyro pre-arm check fail.
# Explicit arming remains mandatory for ICE (ICE_OPTIONS bit 3).
ARMING_CHECK 0
ARMING_REQUIRE 1
ICE_ENABLE 1
ICE_IDLE_DB 50
ICE_IDLE_PCT 5
ICE_IDLE_RPM -1
ICE_IDLE_SLEW 1
ICE_OPTIONS 12
ICE_REDLINE_RPM 8500
ICE_RPM_CHAN 1
ICE_RPM_THRESH 800
ICE_START_DELAY 3
ICE_START_PCT 14
# SITL has no receiver value on RC9 until a joystick/override connects.
# Ignore its zero value while still accepting 1000 PWM as kill and 2000 as start.
ICE_STARTCHN_MIN 800
ICE_STARTER_TIME 1
ICE_STRT_MX_RTRY 2
SERIAL1_PROTOCOL 2
SERIAL1_BAUD 57

# Target airspeed and navigation response
AIRSPEED_CRUISE 24
AIRSPEED_MAX 27
AIRSPEED_MIN 19
AIRSPEED_STALL 0
ROLL_LIMIT_DEG 30
SCALING_SPEED 15
NAVL1_DAMPING 0.75
NAVL1_LIM_BANK 0
NAVL1_PERIOD 19
NAVL1_XTRACK_I 0.02
WP_LOITER_RAD 200
WP_MAX_RADIUS 0
WP_RADIUS 40

# Roll controller from target aircraft
RLL2SRV_RMAX 75
RLL2SRV_TCONST 0.5
RLL_RATE_D 0.00691539
RLL_RATE_D_FF 0
RLL_RATE_FF 0.3561798
RLL_RATE_FLTD 10
RLL_RATE_FLTE 0
RLL_RATE_FLTT 3.183099
RLL_RATE_I 0.3561798
RLL_RATE_IMAX 0.666
RLL_RATE_NEF 0
RLL_RATE_NTF 0
RLL_RATE_P 0.46357
RLL_RATE_PDMX 0
RLL_RATE_SMAX 150

# Pitch controller from target aircraft
PTCH2SRV_RLL 1
PTCH2SRV_RMAX_DN 75
PTCH2SRV_RMAX_UP 75
PTCH2SRV_TCONST 0.75
PTCH_LIM_MAX_DEG 20
PTCH_LIM_MIN_DEG -15
PTCH_RATE_D 0.023203
PTCH_RATE_D_FF 0
PTCH_RATE_FF 0.9962128
PTCH_RATE_FLTD 10
PTCH_RATE_FLTE 0
PTCH_RATE_FLTT 2.122066
PTCH_RATE_I 0.9962128
PTCH_RATE_IMAX 0.666
PTCH_RATE_NEF 0
PTCH_RATE_NTF 0
PTCH_RATE_P 0.7681078
PTCH_RATE_PDMX 0
PTCH_RATE_SMAX 150
PTCH_TRIM_DEG 0
STAB_PITCH_DOWN 2
STALL_PREVENTION 1

# Yaw coordination
KFF_RDDRMIX 0.5
KFF_THR2PTCH 0
YAW2SRV_DAMP 0
YAW2SRV_IMAX 1500
YAW2SRV_INT 0
YAW2SRV_RLL 1
YAW2SRV_SLIP 0
YAW_RATE_ENABLE 0

# TECS values from target aircraft
TECS_APPR_SMAX 3
TECS_CLMB_MAX 3
TECS_FLARE_HGT 6
TECS_HDEM_TCONST 3
TECS_HGT_OMEGA 3
TECS_INTEG_GAIN 0.05
TECS_LAND_ARSPD 22
TECS_LAND_DAMP 0.5
TECS_LAND_IGAIN 0
TECS_LAND_PDAMP 0
TECS_LAND_PMAX 10
TECS_LAND_SINK 1
TECS_LAND_SPDWGT 0.7
TECS_LAND_SRC 0
TECS_LAND_TCONST 3
TECS_LAND_TDAMP 0
TECS_LAND_THR 7
TECS_OPTIONS 0
TECS_PITCH_MAX 15
TECS_PITCH_MIN 0
TECS_PTCH_DAMP 0.3
TECS_PTCH_FF_K 0
TECS_PTCH_FF_V0 12
TECS_RLL2THR 10
TECS_SINK_MAX 5
TECS_SINK_MIN 2
TECS_SPDWEIGHT 1
TECS_SPD_OMEGA 2
TECS_SYNAIRSPEED 0
TECS_THR_DAMP 1.4
TECS_TIME_CONST 12
TECS_TKOFF_IGAIN 0
TECS_VERT_ACC 7

# Throttle response
THROTTLE_NUDGE 1
THR_FAILSAFE 1
THR_FS_VALUE 950
THR_MAX 95
THR_MIN 6
THR_PASS_STAB 0
THR_SLEWRATE 30
THR_SUPP_MAN 0
TRIM_THROTTLE 24

# Runway takeoff
TKOFF_ACCEL_CNT 1
TKOFF_ALT 50
TKOFF_DIST 200
TKOFF_FLAP_PCNT 0
TKOFF_GND_PITCH 5
TKOFF_LVL_ALT 15
TKOFF_LVL_PITCH 5
TKOFF_OPTIONS 0
TKOFF_PLIM_SEC 2
TKOFF_ROTATE_SPD 20
TKOFF_TDRAG_ELEV 0
TKOFF_TDRAG_SPD1 0
TKOFF_THR_DELAY 2
TKOFF_THR_MAX 0
TKOFF_THR_MAX_T 4
TKOFF_THR_MIN 0
TKOFF_THR_MINACC 0
TKOFF_THR_MINSPD 0
TKOFF_THR_SLEW 20
TKOFF_TIMEOUT 0

# Landing behavior
LAND_ABORT_DEG 0
LAND_ABORT_THR 0
LAND_DISARMDELAY 120
LAND_FLAP_PERCNT 0
LAND_FLARE_AIM 100
LAND_FLARE_ALT 3
LAND_FLARE_SEC 2
LAND_OPTIONS 0
LAND_PF_ALT 15
LAND_PF_ARSPD 21
LAND_PF_SEC 6
LAND_PITCH_DEG 3
LAND_SLOPE_RCALC 2
LAND_THEN_NEUTRL 0
LAND_THR_SLEW 0
LAND_TYPE 0
LAND_WIND_COMP 0

# Modes and general handling
ACRO_LOCKING 0
ACRO_PITCH_RATE 180
ACRO_ROLL_RATE 180
ACRO_YAW_RATE 0
AUTOTUNE_AXES 7
AUTOTUNE_LEVEL 6
AUTOTUNE_OPTIONS 0
FBWB_CLIMB_RATE 2
FBWB_ELEV_REV 0
FLTMODE1 2
FLTMODE2 5
FLTMODE3 2
FLTMODE4 5
FLTMODE5 0
FLTMODE6 0
FLTMODE_CH 8
FLTMODE_GCSBLOCK 0
LEVEL_ROLL_LIMIT 5
RTL_ALTITUDE 200
RTL_AUTOLAND 1
RTL_CLIMB_MIN 0
RTL_RADIUS 0

# Flap and ground-steering behavior
DSPOILER_AILMTCH 100
DSPOILER_CROW_W1 0
DSPOILER_CROW_W2 0
DSPOILER_OPTS 3
DSPOILR_RUD_RATE 100
FLAP_1_PERCNT 0
FLAP_1_SPEED 0
FLAP_2_PERCNT 0
FLAP_2_SPEED 0
FLAP_SLEWRATE 75
GROUND_STEER_ALT 5
GROUND_STEER_DPS 90

# RC input mapping
RCMAP_ROLL 1
RCMAP_PITCH 2
RCMAP_THROTTLE 3
RCMAP_YAW 4
RC_OVERRIDE_TIME 0.5
RC9_DZ 0
RC9_MIN 999
RC9_MAX 2000
RC9_TRIM 999
RC9_REVERSED 0
RC9_OPTION 179

# JSBSim output adapter.  ArduPilot 4.6.3 consumes channels 1..4 as
# aileron/elevator/throttle/rudder.  The aerodynamic model represents the
# target flaperon/V-tail effects; loading the physical output numbers here
# would route throttle into the aileron input and is therefore unsafe.
SERVO1_FUNCTION 4
SERVO1_MIN 1100
SERVO1_MAX 1900
SERVO1_TRIM 1500
SERVO1_REVERSED 0
SERVO2_FUNCTION 19
SERVO2_MIN 1100
SERVO2_MAX 1900
SERVO2_TRIM 1500
SERVO2_REVERSED 1
SERVO3_FUNCTION 70
SERVO3_MIN 1000
SERVO3_MAX 2000
SERVO3_TRIM 1000
SERVO3_REVERSED 0
SERVO4_FUNCTION 21
SERVO4_MIN 1100
SERVO4_MAX 1900
SERVO4_TRIM 1500
SERVO4_REVERSED 0
SERVO5_FUNCTION 0
SERVO6_FUNCTION 0
SERVO7_FUNCTION 69
SERVO7_MIN 1000
SERVO7_MAX 2000
SERVO7_TRIM 1000
SERVO7_REVERSED 0
SERVO8_FUNCTION 67
SERVO8_MIN 1000
SERVO8_MAX 2000
SERVO8_TRIM 1000
SERVO8_REVERSED 0
SERVO9_FUNCTION 0
SERVO10_FUNCTION 0
SERVO11_FUNCTION 0
SERVO12_FUNCTION 0
SERVO13_FUNCTION 0
SERVO14_FUNCTION 0
SERVO15_FUNCTION 0
SERVO16_FUNCTION 0
SERVO_AUTO_TRIM 1
