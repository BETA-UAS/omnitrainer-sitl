<?xml version="1.0"?>
<?xml-stylesheet href="http://jsbsim.sourceforge.net/JSBSim.xsl" type="text/xsl"?>

<fdm_config name="Omni-Trainer" version="2.0" release="BETA"
 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
 xsi:noNamespaceSchemaLocation="http://jsbsim.sourceforge.net/JSBSim.xsd">

    <fileheader>
        <author>Bim / OpenAI</author>
        <filecreationdate>2026-04-25</filecreationdate>
        <version>1.2</version>
        <description>
            Omni-Trainer JSBSim model tuned for 15 kg fixed-wing trainer,
            2.7 m span, 0.75 m2 wing area, 24 m/s measured cruise;
            log-calibrated propeller surrogate and A-tail. EFI uses matching RPM map.
        </description>
    </fileheader>

    <metrics>
        <!-- 0.75 m2 = 8.073 ft2 -->
        <!-- Measured 2.7 m = 8.858 ft -->
        <!-- S/b = 0.278 m = 0.911 ft; MAC is unmeasured -->

        <wingarea unit="FT2">8.073</wingarea>
        <wingspan unit="FT">8.858</wingspan>
        <chord unit="FT">0.911</chord>

        <!-- Approximate inverted V-tail equivalent areas -->
        <htailarea unit="FT2">1.30</htailarea>
        <htailarm unit="FT">3.20</htailarm>
        <vtailarea unit="FT2">0.85</vtailarea>
        <vtailarm unit="FT">3.20</vtailarm>

        <location name="AERORP" unit="IN">
            <x>34.5</x>
            <y>0.0</y>
            <z>0.0</z>
        </location>

        <location name="EYEPOINT" unit="IN">
            <x>25.0</x>
            <y>0.0</y>
            <z>8.0</z>
        </location>

        <location name="VRP" unit="IN">
            <x>0.0</x>
            <y>0.0</y>
            <z>0.0</z>
        </location>
    </metrics>

    <mass_balance>
        <!-- Inertia is a provisional prior; flight log does not identify it. -->
        <ixx unit="SLUG*FT2">1.85</ixx>
        <iyy unit="SLUG*FT2">2.95</iyy>
        <izz unit="SLUG*FT2">4.35</izz>
        <ixy unit="SLUG*FT2">0.0</ixy>
        <ixz unit="SLUG*FT2">0.0</ixz>
        <iyz unit="SLUG*FT2">0.0</iyz>

        <!-- 30.0 lb non-fuel mass plus 3.1 lb in the tank = 33.1 lb (15.0 kg).
             Do not add a pointmass for the same fuel: JSBSim already counts the tank. -->
        <emptywt unit="LBS">30.0</emptywt>

        <location name="CG" unit="IN">
            <x>34.5</x>
            <y>0.0</y>
            <z>0.0</z>
        </location>

    </mass_balance>

    <ground_reactions>
        <contact type="BOGEY" name="LEFT_MLG">
            <location unit="IN">
                <x>40.5</x>
                <y>-14.0</y>
                <z>-13.8</z>
            </location>

            <static_friction>0.08</static_friction>
            <dynamic_friction>0.06</dynamic_friction>
            <rolling_friction>0.012</rolling_friction>

            <spring_coeff unit="LBS/FT">1150</spring_coeff>
            <damping_coeff unit="LBS/FT/SEC">240</damping_coeff>
            <max_steer unit="DEG">0.0</max_steer>

            <brake_group>NONE</brake_group>
            <retractable>0</retractable>
        </contact>

        <contact type="BOGEY" name="RIGHT_MLG">
            <location unit="IN">
                <x>40.5</x>
                <y>14.0</y>
                <z>-13.8</z>
            </location>

            <static_friction>0.08</static_friction>
            <dynamic_friction>0.06</dynamic_friction>
            <rolling_friction>0.012</rolling_friction>

            <spring_coeff unit="LBS/FT">1150</spring_coeff>
            <damping_coeff unit="LBS/FT/SEC">240</damping_coeff>
            <max_steer unit="DEG">0.0</max_steer>

            <brake_group>NONE</brake_group>
            <retractable>0</retractable>
        </contact>

        <contact type="BOGEY" name="NOSE_LG">
            <location unit="IN">
                <x>22.0</x>
                <y>0.0</y>
                <z>-14.2</z>
            </location>

            <static_friction>0.08</static_friction>
            <dynamic_friction>0.06</dynamic_friction>
            <rolling_friction>0.012</rolling_friction>

            <spring_coeff unit="LBS/FT">850</spring_coeff>
            <damping_coeff unit="LBS/FT/SEC">170</damping_coeff>
            <max_steer unit="DEG">28.0</max_steer>

            <brake_group>NONE</brake_group>
            <retractable>0</retractable>
        </contact>
    </ground_reactions>

    <propulsion>
        <engine file="DLE30_EFI">
            <location unit="IN">
                <x>36.0</x>
                <y>0.0</y>
                <z>0.0</z>
            </location>

            <orient unit="DEG">
                <roll>0.0</roll>
                <pitch>0.0</pitch>
                <yaw>0.0</yaw>
            </orient>

            <feed>0</feed>

            <thruster file="18x10">
                <location unit="IN">
                    <x>1.0</x>
                    <y>0.0</y>
                    <z>0.0</z>
                </location>

                <orient unit="DEG">
                    <roll>0.0</roll>
                    <pitch>0.0</pitch>
                    <yaw>0.0</yaw>
                </orient>

                <p_factor>1.0</p_factor>
            </thruster>
        </engine>

        <tank type="FUEL">
            <location unit="IN">
                <x>34.0</x>
                <y>0.0</y>
                <z>0.0</z>
            </location>

            <capacity unit="LBS">6.52</capacity>
            <contents unit="LBS">3.10</contents>
        </tank>
    </propulsion>

    <flight_control name="FCS: Omni-Trainer">
        <property value="0">fcs/engine-enabled-norm</property>
        <channel name="All">

            <summer name="Pitch Trim Sum">
                <input>fcs/elevator-cmd-norm</input>
                <input>fcs/pitch-trim-cmd-norm</input>
                <clipto>
                    <min>-1.0</min>
                    <max>1.0</max>
                </clipto>
            </summer>

            <aerosurface_scale name="Elevator Control">
                <input>fcs/pitch-trim-sum</input>
                <range>
                    <min>-0.24</min>
                    <max>0.22</max>
                </range>
                <output>fcs/elevator-pos-rad</output>
            </aerosurface_scale>

            <aerosurface_scale name="Elevator Normalized">
                <input>fcs/elevator-pos-rad</input>
                <domain>
                    <min>-0.24</min>
                    <max>0.22</max>
                </domain>
                <range>
                    <min>-1.0</min>
                    <max>1.0</max>
                </range>
                <output>fcs/elevator-pos-norm</output>
            </aerosurface_scale>

            <summer name="Roll Trim Sum">
                <input>fcs/aileron-cmd-norm</input>
                <input>fcs/roll-trim-cmd-norm</input>
                <clipto>
                    <min>-1.0</min>
                    <max>1.0</max>
                </clipto>
            </summer>

            <aerosurface_scale name="Left Aileron Control">
                <input>fcs/roll-trim-sum</input>
                <range>
                    <min>-0.35</min>
                    <max>0.35</max>
                </range>
                <output>fcs/left-aileron-pos-rad</output>
            </aerosurface_scale>

            <aerosurface_scale name="Right Aileron Control">
                <input>-fcs/roll-trim-sum</input>
                <range>
                    <min>-0.35</min>
                    <max>0.35</max>
                </range>
                <output>fcs/right-aileron-pos-rad</output>
            </aerosurface_scale>

            <aerosurface_scale name="Left Aileron Normalized">
                <input>fcs/left-aileron-pos-rad</input>
                <domain>
                    <min>-0.35</min>
                    <max>0.35</max>
                </domain>
                <range>
                    <min>-1.0</min>
                    <max>1.0</max>
                </range>
                <output>fcs/left-aileron-pos-norm</output>
            </aerosurface_scale>

            <aerosurface_scale name="Right Aileron Normalized">
                <input>fcs/right-aileron-pos-rad</input>
                <domain>
                    <min>-0.35</min>
                    <max>0.35</max>
                </domain>
                <range>
                    <min>-1.0</min>
                    <max>1.0</max>
                </range>
                <output>fcs/right-aileron-pos-norm</output>
            </aerosurface_scale>

            <summer name="Rudder Command Sum">
                <input>fcs/rudder-cmd-norm</input>
                <input>fcs/yaw-trim-cmd-norm</input>
                <clipto>
                    <min>-1.0</min>
                    <max>1.0</max>
                </clipto>
            </summer>

            <aerosurface_scale name="Rudder Control">
                <input>fcs/rudder-command-sum</input>
                <range>
                    <min>-0.35</min>
                    <max>0.35</max>
                </range>
                <output>fcs/rudder-pos-rad</output>
            </aerosurface_scale>

            <aerosurface_scale name="Rudder Normalized">
                <input>fcs/rudder-pos-rad</input>
                <domain>
                    <min>-0.35</min>
                    <max>0.35</max>
                </domain>
                <range>
                    <min>-1.0</min>
                    <max>1.0</max>
                </range>
                <output>fcs/rudder-pos-norm</output>
            </aerosurface_scale>

            <!-- Left/right inverted-V ruddervators after the firmware-equivalent
                 0.5 pitch/yaw mix. Their actual angle and linkage remain unknown. -->
            <pure_gain name="fcs/tail-pitch-half">
                <input>fcs/pitch-trim-sum</input><gain>0.5</gain>
            </pure_gain>
            <pure_gain name="fcs/tail-yaw-half">
                <input>fcs/rudder-command-sum</input><gain>0.5</gain>
            </pure_gain>
            <summer name="fcs/left-ruddervator-norm">
                <input>fcs/tail-pitch-half</input>
                <input>fcs/tail-yaw-half</input>
                <clipto><min>-1</min><max>1</max></clipto>
            </summer>
            <summer name="fcs/right-ruddervator-norm">
                <input>fcs/tail-pitch-half</input>
                <input>-fcs/tail-yaw-half</input>
                <clipto><min>-1</min><max>1</max></clipto>
            </summer>
            <aerosurface_scale name="fcs/left-ruddervator-deflection">
                <input>fcs/left-ruddervator-norm</input>
                <range><min>-0.46</min><max>0.46</max></range>
                <output>fcs/left-ruddervator-pos-rad</output>
            </aerosurface_scale>
            <aerosurface_scale name="fcs/right-ruddervator-deflection">
                <input>fcs/right-ruddervator-norm</input>
                <range><min>-0.46</min><max>0.46</max></range>
                <output>fcs/right-ruddervator-pos-rad</output>
            </aerosurface_scale>
        </channel>
        <channel name="Engine">
            <lag_filter name="fcs/engine-throttle-lag">
                <input>fcs/throttle-cmd-norm</input>
                <c1>7.0</c1>
            </lag_filter>
            <fcs_function name="fcs/engine-power-schedule">
                <function>
                    <product>
                    <property>fcs/engine-enabled-norm</property>
                    <table>
                        <independentVar>fcs/engine-throttle-lag</independentVar>
                        <tableData>
                            0.00  0.000
                            0.06  0.020
                            0.13  0.045
                            0.18  0.160
                            0.23  0.245
                            0.265 0.295
                            0.355 0.440
                            0.46  0.490
                            0.54  0.550
                            0.67  0.630
                            0.95  0.896
                            1.00  1.000
                        </tableData>
                    </table>
                    </product>
                </function>
                <output>fcs/throttle-pos-norm</output>
            </fcs_function>
        </channel>
    </flight_control>

    <aerodynamics>

        <axis name="DRAG">
            <function name="aero/coefficient/CD0">
                <description>Baseline drag calibrated around EAS 24 m/s</description>
                <product>
                    <property>aero/qbar-psf</property>
                    <property>metrics/Sw-sqft</property>
                    <table>
                        <independentVar>aero/alpha-rad</independentVar>
                        <tableData>
                            -1.5700  1.8000
                            -0.4500  0.5000
                            -0.3000  0.2400
                            -0.2000  0.1150
                            -0.1000  0.0660
                             0.0000  0.05650
                             0.1000  0.0660
                             0.2000  0.1150
                             0.3000  0.2400
                             0.4500  0.5000
                             1.5700  1.8000
                        </tableData>
                    </table>
                </product>
            </function>

            <function name="aero/coefficient/CDi">
                <description>Induced drag prior: k near 1/(pi*AR*e), e approximately 0.8</description>
                <product>
                    <property>aero/qbar-psf</property>
                    <property>metrics/Sw-sqft</property>
                    <property>aero/cl-squared</property>
                    <value>0.0410</value>
                </product>
            </function>

            <function name="aero/coefficient/CDbeta">
                <description>Drag due to sideslip</description>
                <product>
                    <property>aero/qbar-psf</property>
                    <property>metrics/Sw-sqft</property>
                    <table>
                        <independentVar>aero/beta-rad</independentVar>
                        <tableData>
                            -1.5700  1.3000
                            -0.3500  0.1800
                            -0.2600  0.1100
                             0.0000  0.0000
                             0.2600  0.1100
                             0.3500  0.1800
                             1.5700  1.3000
                        </tableData>
                    </table>
                </product>
            </function>

            <function name="aero/coefficient/CDde">
                <description>Drag due to elevator/ruddervator deflection</description>
                <product>
                    <property>aero/qbar-psf</property>
                    <property>metrics/Sw-sqft</property>
                    <table>
                        <independentVar>fcs/elevator-pos-norm</independentVar>
                        <tableData>
                            -1.0  0.0450
                             0.0  0.0000
                             1.0  0.0450
                        </tableData>
                    </table>
                </product>
            </function>
        </axis>

        <axis name="SIDE">
            <function name="aero/coefficient/CYb">
                <description>Side force due to beta</description>
                <product>
                    <property>aero/qbar-psf</property>
                    <property>metrics/Sw-sqft</property>
                    <property>aero/beta-rad</property>
                    <value>-0.8500</value>
                </product>
            </function>
        </axis>

        <axis name="LIFT">
            <function name="aero/coefficient/CLalpha">
                <description>Lift prior centered on CL about 0.56 at EAS 24 m/s, 15 kg</description>
                <product>
                    <property>aero/qbar-psf</property>
                    <property>metrics/Sw-sqft</property>
                    <table>
                        <independentVar>aero/alpha-rad</independentVar>
                        <tableData>
                            -0.3500  -0.9500
                            -0.2500  -0.6500
                            -0.1500  -0.1200
                            -0.1000   0.1600
                             0.0000   0.4385
                             0.1000   0.9485
                             0.2000   1.2800
                             0.3000   1.4000
                             0.4500   0.9000
                             0.5800   0.4500
                        </tableData>
                    </table>
                </product>
            </function>

            <function name="aero/coefficient/CLde">
                <description>Lift due to elevator/ruddervator</description>
                <product>
                    <property>aero/qbar-psf</property>
                    <property>metrics/Sw-sqft</property>
                    <property>fcs/elevator-pos-rad</property>
                    <value>0.1600</value>
                </product>
            </function>
        </axis>

        <axis name="ROLL">
            <function name="aero/coefficient/Clb">
                <description>Roll moment due to beta</description>
                <product>
                    <property>aero/qbar-psf</property>
                    <property>metrics/Sw-sqft</property>
                    <property>metrics/bw-ft</property>
                    <property>aero/beta-rad</property>
                    <value>-0.0600</value>
                </product>
            </function>

            <function name="aero/coefficient/Clp">
                <description>Increased roll damping for easier manual/FBWA handling</description>
                <product>
                    <property>aero/qbar-psf</property>
                    <property>metrics/Sw-sqft</property>
                    <property>metrics/bw-ft</property>
                    <property>aero/bi2vel</property>
                    <property>velocities/p-aero-rad_sec</property>
                    <value>-1.1000</value>
                </product>
            </function>

            <function name="aero/coefficient/Clr">
                <description>Roll moment due to yaw rate</description>
                <product>
                    <property>aero/qbar-psf</property>
                    <property>metrics/Sw-sqft</property>
                    <property>metrics/bw-ft</property>
                    <property>aero/bi2vel</property>
                    <property>velocities/r-aero-rad_sec</property>
                    <value>0.0500</value>
                </product>
            </function>

            <function name="aero/coefficient/Clda">
                <description>Increased aileron authority for improved roll response in AUTO</description>
                <product>
                    <property>aero/qbar-psf</property>
                    <property>metrics/Sw-sqft</property>
                    <property>metrics/bw-ft</property>
                    <property>fcs/left-aileron-pos-rad</property>
                    <table>
                        <independentVar>velocities/mach</independentVar>
                        <tableData>
                            0.0000  0.4200
                            2.0000  0.3000
                        </tableData>
                    </table>
                </product>
            </function>

            <function name="aero/coefficient/Cldr">
                <description>Roll moment due to rudder</description>
                <product>
                    <property>aero/qbar-psf</property>
                    <property>metrics/Sw-sqft</property>
                    <property>metrics/bw-ft</property>
                    <property>fcs/rudder-pos-rad</property>
                    <value>0.0040</value>
                </product>
            </function>
        </axis>

        <axis name="PITCH">
            <function name="aero/coefficient/Cm0">
                <description>Provisional pitch equilibrium near alpha 1.4 deg in cruise</description>
                <product>
                    <property>aero/qbar-psf</property>
                    <property>metrics/Sw-sqft</property>
                    <property>metrics/cbarw-ft</property>
                    <value>0.0200</value>
                </product>
            </function>
            <function name="aero/coefficient/Cmalpha">
                <description>Pitch static stability</description>
                <product>
                    <property>aero/qbar-psf</property>
                    <property>metrics/Sw-sqft</property>
                    <property>metrics/cbarw-ft</property>
                    <property>aero/alpha-rad</property>
                    <value>-0.9000</value>
                </product>
            </function>

            <function name="aero/coefficient/Cmde">
                <description>Pitch moment due to elevator/ruddervator</description>
                <product>
                    <property>aero/qbar-psf</property>
                    <property>metrics/Sw-sqft</property>
                    <property>metrics/cbarw-ft</property>
                    <property>fcs/elevator-pos-rad</property>
                    <table>
                        <independentVar>velocities/mach</independentVar>
                        <tableData>
                            0.0000  -0.8000
                            2.0000  -0.4500
                        </tableData>
                    </table>
                </product>
            </function>

            <function name="aero/coefficient/Cmq">
                <description>Increased pitch damping for less heavy/porpoising feel</description>
                <product>
                    <property>aero/qbar-psf</property>
                    <property>metrics/Sw-sqft</property>
                    <property>metrics/cbarw-ft</property>
                    <property>aero/ci2vel</property>
                    <property>velocities/q-aero-rad_sec</property>
                    <value>-32.0000</value>
                </product>
            </function>

            <function name="aero/coefficient/Cmadot">
                <description>Pitch moment due to alpha rate</description>
                <product>
                    <property>aero/qbar-psf</property>
                    <property>metrics/Sw-sqft</property>
                    <property>metrics/cbarw-ft</property>
                    <property>aero/ci2vel</property>
                    <property>aero/alphadot-rad_sec</property>
                    <value>-14.0000</value>
                </product>
            </function>
        </axis>

        <axis name="YAW">
            <function name="aero/coefficient/Cnb">
                <description>Yaw static stability</description>
                <product>
                    <property>aero/qbar-psf</property>
                    <property>metrics/Sw-sqft</property>
                    <property>metrics/bw-ft</property>
                    <property>aero/beta-rad</property>
                    <value>0.2200</value>
                </product>
            </function>

            <function name="aero/coefficient/Cnr">
                <description>Yaw damping</description>
                <product>
                    <property>aero/qbar-psf</property>
                    <property>metrics/Sw-sqft</property>
                    <property>metrics/bw-ft</property>
                    <property>aero/bi2vel</property>
                    <property>velocities/r-aero-rad_sec</property>
                    <value>-0.5200</value>
                </product>
            </function>

            <function name="aero/coefficient/Cndr">
                <description>Yaw moment due to rudder/ruddervator</description>
                <product>
                    <property>aero/qbar-psf</property>
                    <property>metrics/Sw-sqft</property>
                    <property>metrics/bw-ft</property>
                    <property>fcs/rudder-pos-rad</property>
                    <value>-0.0800</value>
                </product>
            </function>

            <function name="aero/coefficient/Cnda">
                <description>Adverse yaw due to aileron</description>
                <product>
                    <property>aero/qbar-psf</property>
                    <property>metrics/Sw-sqft</property>
                    <property>metrics/bw-ft</property>
                    <property>fcs/left-aileron-pos-rad</property>
                    <value>-0.0100</value>
                </product>
            </function>
        </axis>

    </aerodynamics>
    <!-- Direct FlightGear UDP output causes repeated "Connection refused" errors
         when FlightGear is not listening. Use a MAVLink/FlightGear bridge when
         visualization is needed. -->
    <!-- <output name="localhost" type="FLIGHTGEAR" port="5503" protocol="udp" rate="30"/> -->
</fdm_config>
