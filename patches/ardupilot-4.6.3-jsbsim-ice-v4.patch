+                 steering, brake, brake);
+        // Channels 7/8 are virtual starter/ignition outputs assigned by the
+        // bundled SITL parameter file. The real aircraft requires arm, then
+        // an ICE start command; throttle alone cannot start its engine.
+        const float starter = filtered_servo_range(input, 6);
+        const float ignition = filtered_servo_range(input, 7);
+        if (ignition < 0.5f) {
+            omni_engine_running = false;
+            omni_starter_elapsed = 0.0f;
+        } else if (starter >= 0.5f && !omni_engine_running) {
+            omni_starter_elapsed += 1.0f / rate_hz;
+            if (omni_starter_elapsed >= 0.3f) {
+                omni_engine_running = true;
