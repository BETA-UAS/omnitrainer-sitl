+    char omni_ground_commands[192] = {};
+    if (strcmp(jsbsim_model, "Omni-Trainer") == 0) {
+        // Servo 6 is ArduPlane GroundSteering; servo 12 passes through RC11.
+        // Only the Omni model has these physical wheel controls.
